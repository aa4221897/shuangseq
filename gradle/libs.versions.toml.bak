[versions]
androidx-work = "2.9.0"
kotlin = "1.9.22"
compose = "2024.02.01"
androidx-core = "1.12.0"
androidx-lifecycle = "2.7.0"

[libraries]
# WorkManager
androidx-work-runtime = { group = "androidx.work", name = "work-runtime", version.ref = "androidx-work" }
androidx-work-runtime-ktx = { group = "androidx.work", name = "work-runtime-ktx", version.ref = "androidx-work" }

# Compose
androidx-compose-bom = { group = "androidx.compose", name = "compose-bom", version.ref = "compose" }

# Core AndroidX
androidx-core-ktx = { group = "androidx.core", name = "core-ktx", version.ref = "androidx-core" }
androidx-lifecycle-runtime-ktx = { group = "androidx.lifecycle", name = "lifecycle-runtime-ktx", version.ref = "androidx-lifecycle" }

[bundles]
androidx-core = ["androidx.core-ktx", "androidx.lifecycle-runtime-ktx"]
androidx-work = ["androidx.work-runtime", "androidx.work-runtime-ktx"]

[plugins]
kotlin-android = { id = "org.jetbrains.kotlin.android", version.ref = "kotlin" }
kotlin-kapt = { id = "org.jetbrains.kotlin.kapt", version.ref = "kotlin" }